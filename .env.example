# ---- Neon Postgres (optional) ----
# The app runs on a seeded in-memory store out of the box. To make data
# persistent, create a free Neon project (https://neon.tech), copy the
# connection string, and paste it below. Then run:
#   npm run db:push   # create tables
#   npm run db:seed   # load the demo account
#
# Use the *pooled* connection string (the host contains "-pooler") — the
# @neondatabase/serverless driver pools over it, which is ideal for the
# serverless/edge runtime this app deploys to.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# Secret used to HMAC-sign session cookies. Change this to any long random
# string in production. Falls back to a dev default if unset.
# SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Buddy AI (optional) ----
# If set, the "Ask Buddy" chat uses the Claude API for open-ended replies
# (grounded in your live financial snapshot). Without it, Buddy uses the
# built-in local data responder — no key or cost required.
# ANTHROPIC_API_KEY="sk-ant-..."

# ---- Email (optional) ----
# If set, verification + password-reset emails are sent via Resend. Without it,
# the links are logged to the server console (and shown in the UI in dev).
# RESEND_API_KEY="re_..."
# EMAIL_FROM="finAI-Buddy <onboarding@resend.dev>"
